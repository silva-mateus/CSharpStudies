@{
    ViewData["Title"] = "Acesso Negado";
}

<div class="row justify-content-center" style="margin-top: 5rem;">
    <div class="col-lg-5">
        <div class="vshop-card text-center p-5">
            <div class="mb-3">
                <i class="fa-solid fa-shield-halved" style="font-size: 4rem; color: var(--vshop-accent);"></i>
            </div>
            <h2 style="font-weight: 400; font-size: 1.5rem;">Acesso Negado</h2>
            <p class="text-muted mt-2 mb-4">
                Você não tem permissão para acessar este recurso.
                Entre em contato com o administrador se acredita que isso é um erro.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-vshop">
                <i class="fa-solid fa-arrow-left"></i> Voltar ao Início
            </a>
        </div>
    </div>
</div>
