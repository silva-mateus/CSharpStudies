@model CartViewModel

@{
    ViewData["Title"] = "Checkout";
    decimal total = 0;
}

<!-- Step Indicator -->
<div class="vshop-steps">
    <div class="vshop-step completed">
        <span class="step-number"><i class="fa-solid fa-check" style="font-size:.65rem;"></i></span>
        Carrinho
    </div>
    <div class="vshop-step-divider"></div>
    <div class="vshop-step active">
        <span class="step-number">2</span>
        Checkout
    </div>
    <div class="vshop-step-divider"></div>
    <div class="vshop-step">
        <span class="step-number">3</span>
        Confirmação
    </div>
</div>

<form asp-action="Checkout" method="post" class="vshop-form">
    <input type="hidden" asp-for="CartHeader.Id" />
    <input type="hidden" asp-for="CartHeader.UserId" />
    <input type="hidden" asp-for="CartHeader.CouponCode" />
    <input type="hidden" asp-for="CartHeader.Discount" />
    <input type="hidden" asp-for="CartHeader.CartTotalItems" />

    <div class="row g-4">
        <!-- Forms Column -->
        <div class="col-lg-7">
            <!-- Personal Data -->
            <div class="vshop-card mb-4">
                <div class="vshop-card-header">
                    <i class="fa-solid fa-user me-1"></i> Dados Pessoais
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CartHeader.FirstName" class="form-label"></label>
                            <input asp-for="CartHeader.FirstName" class="form-control" />
                            <span asp-validation-for="CartHeader.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CartHeader.LastName" class="form-label"></label>
                            <input asp-for="CartHeader.LastName" class="form-control" />
                            <span asp-validation-for="CartHeader.LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CartHeader.Email" class="form-label"></label>
                            <input asp-for="CartHeader.Email" type="email" class="form-control" />
                            <span asp-validation-for="CartHeader.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CartHeader.Phone" class="form-label"></label>
                            <input asp-for="CartHeader.Phone" class="form-control" />
                            <span asp-validation-for="CartHeader.Phone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Data -->
            <div class="vshop-card">
                <div class="vshop-card-header">
                    <i class="fa-solid fa-credit-card me-1"></i> Dados de Pagamento
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CartHeader.CardNumber" class="form-label"></label>
                            <input asp-for="CartHeader.CardNumber" class="form-control"
                                   placeholder="0000 0000 0000 0000" />
                            <span asp-validation-for="CartHeader.CardNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="CartHeader.NameOnCard" class="form-label"></label>
                            <input asp-for="CartHeader.NameOnCard" class="form-control" />
                            <span asp-validation-for="CartHeader.NameOnCard" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CartHeader.ExpiryMonthYear" class="form-label"></label>
                            <input asp-for="CartHeader.ExpiryMonthYear" class="form-control"
                                   placeholder="MM/AA" />
                            <span asp-validation-for="CartHeader.ExpiryMonthYear" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CartHeader.CVV" class="form-label"></label>
                            <input asp-for="CartHeader.CVV" class="form-control"
                                   placeholder="000" maxlength="4" />
                            <span asp-validation-for="CartHeader.CVV" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-3 text-muted" style="font-size:.8rem;">
                        <i class="fa-solid fa-lock me-1"></i> Seus dados estão protegidos com criptografia SSL
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary Column -->
        <div class="col-lg-5">
            <div class="vshop-subtotal-box">
                <h6 style="font-weight:700;font-size:1.05rem;margin-bottom:1rem;">
                    <i class="fa-solid fa-receipt me-1"></i> Resumo do Pedido
                </h6>

                @foreach (var item in Model.CartItems)
                {
                    var subtotal = item.Product.Price * item.Quantity;
                    total += subtotal;

                    <div class="d-flex justify-content-between mb-2" style="font-size:.88rem;">
                        <span>
                            @item.Product.Name
                            <span class="text-muted">x@item.Quantity</span>
                        </span>
                        <span>@subtotal.ToString("C")</span>
                    </div>
                }

                @{
                    var discount = Model.CartHeader.Discount;
                    var totalAfterDiscount = discount > 0 ? total - discount : total;
                    if (totalAfterDiscount < 0) totalAfterDiscount = 0;
                }

                <hr />

                <div class="d-flex justify-content-between mb-1" style="font-size:.88rem;">
                    <span>Subtotal</span>
                    <span>@total.ToString("C")</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.CartHeader.CouponCode) && discount > 0)
                {
                    <div class="d-flex justify-content-between mb-1" style="font-size:.88rem;color:var(--vshop-success);">
                        <span>
                            <i class="fa-solid fa-tag"></i> @Model.CartHeader.CouponCode
                        </span>
                        <span>- @discount.ToString("C")</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.CartHeader.CouponCode))
                {
                    <div class="vshop-coupon-tag mt-1 mb-1" style="font-size:.8rem;">
                        <i class="fa-solid fa-tag"></i> @Model.CartHeader.CouponCode
                    </div>
                }

                <hr />

                <input type="hidden" asp-for="CartHeader.TotalAmount" value="@totalAfterDiscount" />

                <div class="d-flex justify-content-between align-items-center">
                    <span style="font-size:1.1rem;font-weight:700;">Total</span>
                    <span style="font-size:1.4rem;font-weight:700;color:var(--vshop-accent);">
                        @totalAfterDiscount.ToString("C")
                    </span>
                </div>

                <hr />

                <button type="submit" class="btn btn-vshop w-100 mb-2" style="font-size:1rem;">
                    <i class="fa-solid fa-lock"></i> Confirmar Pedido
                </button>

                <a asp-action="Index" class="btn btn-vshop-outline w-100">
                    <i class="fa-solid fa-arrow-left"></i> Voltar ao Carrinho
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
