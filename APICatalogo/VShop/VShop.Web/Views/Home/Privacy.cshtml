@{
    ViewData["Title"] = "Política de Privacidade";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="vshop-card">
            <div class="vshop-card-header">
                <i class="fa-solid fa-user-shield me-1"></i> @ViewData["Title"]
            </div>
            <div class="card-body p-4">
                <p style="font-size:.92rem;color:var(--vshop-text-secondary);line-height:1.7;">
                    A VShop está comprometida com a proteção da sua privacidade. Esta política de privacidade
                    explica como coletamos, usamos e protegemos suas informações pessoais quando você utiliza
                    nosso site e serviços.
                </p>

                <h6 class="mt-4 mb-2" style="font-weight:700;">Coleta de Dados</h6>
                <p style="font-size:.92rem;color:var(--vshop-text-secondary);line-height:1.7;">
                    Coletamos informações que você nos fornece diretamente, como nome, e-mail e dados de
                    pagamento quando realiza uma compra. Também podemos coletar dados de navegação para
                    melhorar sua experiência.
                </p>

                <h6 class="mt-4 mb-2" style="font-weight:700;">Uso das Informações</h6>
                <p style="font-size:.92rem;color:var(--vshop-text-secondary);line-height:1.7;">
                    Utilizamos suas informações para processar pedidos, enviar comunicações relevantes e
                    melhorar nossos serviços. Não compartilhamos seus dados com terceiros sem seu consentimento.
                </p>

                <h6 class="mt-4 mb-2" style="font-weight:700;">Segurança</h6>
                <p style="font-size:.92rem;color:var(--vshop-text-secondary);line-height:1.7;">
                    Implementamos medidas de segurança adequadas para proteger suas informações pessoais
                    contra acesso não autorizado, alteração ou destruição.
                </p>
            </div>
        </div>
    </div>
</div>
