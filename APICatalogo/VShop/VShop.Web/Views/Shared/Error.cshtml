@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="row justify-content-center" style="margin-top: 5rem;">
    <div class="col-lg-5">
        <div class="vshop-card text-center p-5">
            <div class="mb-3">
                <i class="fa-solid fa-exclamation-circle" style="font-size: 4rem; color: var(--vshop-accent);"></i>
            </div>
            <h2 style="font-weight: 400; font-size: 1.5rem;">Ops! Algo deu errado</h2>
            <p class="text-muted mt-2 mb-3">
                Ocorreu um erro ao processar sua solicitação. Tente novamente mais tarde.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="text-muted mb-3" style="font-size: .82rem;">
                    <strong>ID da Solicitação:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-vshop">
                <i class="fa-solid fa-arrow-left"></i> Voltar ao Início
            </a>
        </div>
    </div>
</div>
